# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Set to "false" once your own catalog is loaded, so demo products stop being added.
# SEED_DEMO_DATA=false

# ── Paddle payments ─────────────────────────────────────────────────────────
# Leave these unset and the shop runs in test mode: orders can be placed, but
# no payment is taken and every screen says so.
#
# Keep real values out of this file, out of chat and out of the code
# repository. Add them as secrets (environment variables) where the site runs.
# Paddle automatically revokes API keys it finds in public repositories, and
# an API key is only shown once when it is created.
#
# Start with SANDBOX keys. Paddle's sandbox is a separate system with its own
# keys and settings, and it does not need your domain approved. Live checkout
# only opens on a domain Paddle has approved:
#   Paddle > My account > Settings > Website approval
#
# Paddle > My account > Settings > Authentication
#   Create an API key with the fewest permissions that work. This shop only
#   creates and reads transactions, so start with Transactions read and write.
#   If the first payment fails with "(Paddle: forbidden)", also allow Products
#   and Prices write: order lines are created in Paddle on the fly.
PADDLE_API_KEY=            # pdl_sdbx_apikey_... or pdl_live_apikey_... (secret)
#   On the same screen, create a client-side token.
PADDLE_CLIENT_TOKEN=       # test_... or live_... (public by design)
#
# Paddle > Checkout > Checkout configuration > Default payment link
#   Must be set, separately in sandbox and in live, or payments cannot start
#   (the checkout then shows "Paddle: transaction_default_checkout_url_not_set").
#
# Webhook, once the site is on its permanent address. Create a notification
# destination (https://developer.paddle.com/webhooks/notification-destinations):
#   URL:    https://YOUR-DOMAIN/api/paddle/webhook
#   Events: transaction.paid, transaction.completed, transaction.canceled
PADDLE_WEBHOOK_SECRET=     # that destination's secret key (secret)
#
# Optional. Worked out from the key prefixes when left out.
# PADDLE_ENVIRONMENT=sandbox   # or production
