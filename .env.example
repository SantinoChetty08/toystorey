# Copy to .env (local) or set these in your hosting provider's environment settings.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Paddle (merchant of record checkout)
# Server-side API key - keep secret
PADDLE_API_KEY=
# Secret for the webhook destination pointing at /api/webhooks/paddle - keep secret
PADDLE_WEBHOOK_SECRET=
# "sandbox" or "production"
PADDLE_ENVIRONMENT=sandbox

# Client-side Paddle.js token and environment (safe to expose)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
